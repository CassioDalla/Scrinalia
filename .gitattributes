# One repository, several operating systems: normalize the line endings on checkout and commit, so a
# Windows contributor does not rewrite every file, and the diff of a one-line change stays one line.
* text=auto eol=lf

# Binary files: git must not try to normalize or diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.gz binary
*.zip binary

# Generated and vendored files: keep them out of the language statistics, because they are not the
# code someone is coming to read. The contract is generated from the Python app; the lockfiles are
# generated by uv and bun; the SPA build is generated by Vite.
packages/api-contract/openapi.json linguist-generated=true
apps/curator/src/api/schema.d.ts linguist-generated=true
uv.lock linguist-generated=true
bun.lock linguist-generated=true

# A lockfile conflict is not resolved by hand: it is regenerated. Marking them keeps a merge from
# pretending otherwise.
uv.lock -diff
bun.lock -diff
