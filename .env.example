# Copy to `.env` and adjust. The file is gitignored; never commit real credentials.
# Values shown are the defaults the application already assumes, so a local
# `docker compose up -d` works with this file untouched.

# --- Database (must match docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASS=admin123
DB_NAME=scrinalia
# libpq `sslmode`. `prefer` is the local default; a database reached across a network (the runner
# on the GPU host) sets `verify-full` with a CA. It is appended to the derived DATABASE_URL.
DB_SSLMODE=prefer
# The external runner's own DSN, optional. When set, the runner (and only it) connects with this
# URL — a full DSN, so it can carry its own host and `sslmode=verify-full` — which is how a GPU host
# holds a least-privilege role without the API's credential (ADR 0014). Unset, the runner uses the
# DB_* above. Do not commit a real value.
# RUNNER_DATABASE_URL=postgresql+psycopg2://scrinalia_runner:...@db.example.org:5432/scrinalia?sslmode=verify-full

# --- Public site that gets scraped ---
PUBLIC_SCRAPE_URL=
PUBLIC_SCRAPE_DETAIL_URL=

# --- Origin whose fields the staging transform reads ---
# Names the SourceSchema in `src/scrinalia/domains/ingestion/sources.py`: which of the site's
# field labels fills which staging column. The labels are the site's own and are never
# translated. There is NO default on purpose — a fallback would make an installation that never
# declared its origin read the reference site's vocabulary. `pmc` is the only one shipped.
# Required by the staging pipeline, not by boot: without it, `python -m scrinalia.domains.staging.worker`
# fails fast instead of filing every column as unknown.
ACERVO_SOURCE=pmc

# --- Language of the collection ---
# Selects the profile in `src/scrinalia/core/language/` that the date parser, the subject
# guard, the plural rules and the clustering/NER presets read. `pt-BR` is the only profile
# shipped today. The full-text dictionary is part of it and reaches a generated column, so
# changing this value needs a migration, not just a restart.
ACERVO_LANGUAGE=pt-BR

# --- Object storage: **any** S3-compatible endpoint, and not part of ``docker compose`` ---
# The project needs the API, not a particular product: MinIO, Ceph, SeaweedFS or a cloud bucket are
# infrastructure the operator brings. The bucket is confirmed once before the thumbnail worker
# uploads to it, and the credentials need read/write on it. From inside the ``app`` container,
# ``localhost`` is the container itself — use the service's address on your network.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Off by default: the app does not provision the operator's storage. Turn it on for a local
# endpoint (MinIO, SeaweedFS) and the worker creates ``S3_BUCKET_NAME`` when it is missing; with it
# off, a missing bucket refuses the run with the command that creates it instead of failing every
# upload with the endpoint's ``AccessDenied``.
S3_AUTO_CREATE_BUCKET=false

# --- LLM host used by the Ollama-backed engines ---
# This one is read wherever the application runs directly (uvicorn on the host).
OLLAMA_HOST_URL=http://localhost:11434
# The application *container* takes its host from here instead, because a `docker-compose.yml`
# `environment:` entry wins over `env_file`: the value above would say `localhost`, which inside
# the container is the container itself. Empty means the compose default
# (`http://host.docker.internal:11434`), which is what reaches an Ollama running on the host.
# Check what the container will really get with `docker compose --profile app config`.
APP_OLLAMA_HOST_URL=

# --- Observability ---
LOG_DIR=logs
LOG_LEVEL=INFO
DEBUG=false

# --- Authentication (see docs/adr/0009-authentication-and-authorization.md) ---
# The session cookie is first-party: the API serves the curator SPA from the same origin, so there is
# no CORS and no token in JavaScript. The first administrator is created on the host, not through a
# route — a route that creates an admin when none exists is an open door:
#
#   uv run python -m scrinalia.domains.identity.cli create --email voce@instituicao.org --name "Seu Nome" --role ADMIN
#
AUTH_SESSION_COOKIE_NAME=scrinalia_session
# Sliding lifetime, in minutes. The second value is how long a session may sit idle before the expiry
# is pushed forward: touching it on every request would turn every read into a write.
AUTH_SESSION_TTL_MINUTES=720
AUTH_SESSION_TOUCH_MINUTES=15
# **Set this to true behind HTTPS.** Over plain HTTP the browser drops a `Secure` cookie silently, so
# the login looks like it worked while nothing is stored — which is why the default is false and why a
# public deployment must change it.
AUTH_COOKIE_SECURE=false
# Password policy, enforced in the domain (the CLI does not go through a request body).
AUTH_PASSWORD_MIN_LENGTH=12
# argon2id cost: RFC 9106's second recommendation (64 MiB, t=3, p=4). Raising them does not invalidate
# existing hashes — they keep verifying and are upgraded on the next successful login.
AUTH_PASSWORD_MEMORY_KIB=65536
AUTH_PASSWORD_TIME_COST=3
AUTH_PASSWORD_PARALLELISM=4
# Lockout of one account after repeated failed sign-ins, counted in the database so a restart does not
# forget it. Each further lockout doubles the window up to the ceiling, so a guesser has no fixed
# retry schedule. Resetting the password lifts the lock.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_LOGIN_LOCKOUT_MAX_MINUTES=240
# Per-address brake on the login route, in front of the per-account lockout. It lives in the process,
# so it resets on restart: it stops one address from walking the account list, and the durable
# guarantee is the lockout above.
AUTH_LOGIN_RATE_MAX=20
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
# Extra origins accepted on mutating requests, comma-separated. Leave empty for a same-origin
# deployment; declare the public origin when a reverse proxy rewrites `Host` to an internal name.
AUTH_TRUSTED_ORIGINS=
